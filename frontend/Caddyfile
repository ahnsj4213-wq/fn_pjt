# Plain HTTP on :80 inside the container (published as http://localhost:8080). localhost is a secure context, so
# the microphone works. For other PCs use HTTPS (TRD 01 §6.2: `tls internal` or a company certificate).
:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
		-Server
	}
	handle /api/* {
		reverse_proxy app:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
