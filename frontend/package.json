{
  "name": "aihire-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 채용 플랫폼 웹 화면 (지원자·담당자 SPA). 외부 CDN·웹폰트 없이 번들만으로 동작한다 (AC-22).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
