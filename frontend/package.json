    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:offline": "node scripts/check-dist-urls.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.105.0",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
