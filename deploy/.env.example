# Copy to deploy/.env (Windows: copy .env.example .env) and adjust. Every value has a default in docker-compose.yml.

# ── Web ─────────────────────────────────────────────────────────────────────
# Browser URL: http://localhost:8080. WEB_BIND=0.0.0.0 lets other PCs connect (they then need HTTPS for the
# microphone, and this PC's LAN IP in TRUSTED_ORIGINS and RTC_ANNOUNCE_IPS).
WEB_BIND=127.0.0.1
WEB_PORT=8080
TRUSTED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
# Addresses the browser uses for WebRTC voice. Add this PC's LAN IP for other PCs, e.g. ["127.0.0.1", "192.168.0.10"]
RTC_ANNOUNCE_IPS=["127.0.0.1"]

# ── Models ──────────────────────────────────────────────────────────────────
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b
# Ollama image tag; match the version already working on this PC (`ollama --version`) if `latest` misbehaves.
OLLAMA_TAG=latest
# true = download Whisper/Supertonic on the first start (needs internet once). false = offline (models must exist).
MODEL_AUTO_DOWNLOAD=true
# cuda | cpu (cpu falls back to Whisper small)
STT_DEVICE=cuda
# shared | stt_preempts_batch (S-10)
GPU_POLICY=shared
# Reuse the models already on this PC instead of downloading again (forward slashes on Windows):
# OLLAMA_MODELS_DIR=C:/Users/<you>/.ollama/models
# MODEL_CACHE_DIR=C:/Users/<you>/.cache

# ── Secrets (development values; change them for anything beyond a local demo) ─
POSTGRES_PASSWORD=aihire_dev_only
AI_TOKEN=dev-ai-token-change-me
RUNNER_TOKEN=dev-runner-token-change-me

# ── Building behind a TLS-inspecting proxy ──────────────────────────────────
# PEM file with the proxy's CA, inside deploy/ (e.g. ./build-ca.local.pem). Empty = not needed.
# BUILD_CA_FILE=./build-ca.local.pem
