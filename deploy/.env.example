# Copy to deploy/.env (Windows: copy .env.example .env) and adjust. Every value has a default in docker-compose.yml.

# ── Web ─────────────────────────────────────────────────────────────────────
# Browser URL: http://localhost:8080 (frontend :3000 published on 127.0.0.1 only).
WEB_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
TRUSTED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
# Addresses the browser uses for WebRTC voice (UDP 40000-40019 on 127.0.0.1).
RTC_ANNOUNCE_IPS=["127.0.0.1"]

# ── AI (models in ../models, filled by backend/scripts/prepare_models.py) ───
# direct = llm-rt / llm-eval / stt / tts / embed containers. fake = no models (docker-compose.verify.yml).
AI_MODE=direct
LLM_MODEL=qwen3.5:4b
# llm-rt context, split over its 2 slots. Lower to 8192 if llm-rt or stt runs out of GPU memory (6 GB).
LLM_RT_CTX=16384
# CPU threads for llm-eval (grading); leave a few cores for the API and the sandbox.
LLM_EVAL_THREADS=6
# cuda | cpu (cpu falls back to Whisper small)
STT_DEVICE=cuda
# llama.cpp image tags (ghcr.io/ggml-org/llama.cpp). Pin a build (e.g. server-cuda-b6500) once one works.
LLAMACPP_CUDA_TAG=server-cuda
LLAMACPP_CPU_TAG=server

# ── Files (MinIO, encrypted at rest) ────────────────────────────────────────
# s3 = MinIO (needs COMPOSE_PROFILES=minio). local = the appdata volume: remove `minio` from COMPOSE_PROFILES.
STORAGE_BACKEND=s3
COMPOSE_PROFILES=minio
# MinIO no longer publishes images on Docker Hub: put the image you chose here (deploy/README.md §1).
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=aihire
MINIO_ROOT_PASSWORD=dev-minio-secret-change-me
# "name:base64 of 32 random bytes" (PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
MINIO_KMS_SECRET_KEY=aihire-dev:aKULpVexvUWG9PIUC2xQIAltKIx3rQSGlR+6YThYXsU=

# ── Mail (mailer = Mailpit) ─────────────────────────────────────────────────
# Team PCs: leave MAIL_RELAY_HOST empty; every mail stays in Mailpit (http://127.0.0.1:8025).
# Reference PC: relay to Gmail with an app password (Google account → Security → App passwords).
MAIL_FROM=no-reply@aihire.local
MAIL_RELAY_HOST=
# MAIL_RELAY_HOST=smtp.gmail.com
# MAIL_RELAY_PORT=587
# MAIL_RELAY_STARTTLS=true
# MAIL_RELAY_AUTH=plain
# MAIL_RELAY_USERNAME=you@gmail.com
# MAIL_RELAY_PASSWORD=<16-letter app password>
# MAIL_RELAY_ALL=true
# With Gmail, MAIL_FROM should be the same Gmail address.

# ── Secrets (development values; change them for anything beyond a local demo) ─
POSTGRES_PASSWORD=aihire_dev_only
AI_TOKEN=dev-ai-token-change-me

# ── Building behind a TLS-inspecting proxy ──────────────────────────────────
# PEM file with the proxy's CA, inside deploy/ (e.g. ./build-ca.local.pem). Empty = not needed.
# BUILD_CA_FILE=./build-ca.local.pem
